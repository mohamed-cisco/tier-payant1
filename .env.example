# ============================================================
#  PROJET TIERS PAYANT - MODELE DE CONFIGURATION
#
#  Ce fichier est sans danger et doit etre commite.
#  Pour installer le projet :
#      cp .env.example .env
#  puis renseignez les valeurs reelles dans .env (jamais commite).
# ============================================================

# --- Django ---
# Generez une cle avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=remplacez-par-une-cle-aleatoire
DJANGO_DEBUG=True
# Separatees par des virgules, sans espace. Exemple intranet :
#   DJANGO_ALLOWED_HOSTS=tiers-payant.intranet.local,192.168.1.50,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base PostgreSQL ---
DB_NAME=tiers_payant
DB_USER=postgres
DB_PASSWORD=remplacez-par-le-mot-de-passe
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Fichiers statiques ---
# Chemin collecte par `manage.py collectstatic`, servi par Nginx en production.
STATIC_ROOT=staticfiles

# --- E-mail ---
# En developpement : django.core.mail.backends.console.EmailBackend
# En production    : django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.votre-domaine.local
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=ne-pas-repondre@votre-domaine.local

# --- HTTPS / en-tetes de securite ---
# A passer a True en production des que le site est servi en HTTPS.
# SECURE_HSTS_SECONDS : commencez a 600 pour tester, puis montez a 31536000 (1 an).
# Attention, HSTS est difficile a revenir en arriere une fois actif.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
